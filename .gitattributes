# Line endings that each system's tools expect, whatever computer the files are edited on.
* text=auto
*.sh text eol=lf
*.command text eol=lf
*.yml text eol=lf
*.bat text eol=crlf
*.iss text eol=crlf
*.reg text eol=crlf
# Pictures and icons are kept as they are.
*.png binary
*.icns binary
*.ico binary
*.ttf binary
*.otf binary
