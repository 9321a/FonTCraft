Windows Registry Editor Version 5.00

; FontCraft libraries (.fcl) open with FontCraft and show FontCraft's document icon.
; Change the paths if FontCraft is installed somewhere else.

[HKEY_CURRENT_USER\Software\Classes\.fcl]
@="FontCraft.Library"

[HKEY_CURRENT_USER\Software\Classes\FontCraft.Library]
@="FontCraft Library"

[HKEY_CURRENT_USER\Software\Classes\FontCraft.Library\DefaultIcon]
@="C:\\Program Files\\FontCraft\\fontcraft-library.ico"

[HKEY_CURRENT_USER\Software\Classes\FontCraft.Library\shell\open\command]
@="\"C:\\Program Files\\FontCraft\\fontcraft.exe\" \"%1\""
