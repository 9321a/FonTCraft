<?xml version='1.0' encoding='windows-1252'?>
<Wix xmlns='http://microsoft.com'>
    <Product Id='*' Name='FontCraft' UpgradeCode='12345678-1234-1234-1234-123456789012' Version='1.0.0' Language='1033' Manufacturer='Ancizar'>
        <Package InstallerVersion='200' Compressed='yes' InstallScope='perMachine' Description='FontCraft Windows Installer'/>
        <MajorUpgrade DowngradeErrorMessage='Una version mas nueva de FontCraft ya esta instalada.' />
        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>
        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='ProgramFiles64Folder'>
                <Directory Id='APPLICATIONFOLDER' Name='FontCraft'>
                    <Component Id='MainExecutable' Guid='87654321-4321-4321-4321-210987654321' Win64='yes'>
                        <File Id='FontCraftEXE' Source='target/x86_64-pc-windows-gnu/release/FontCraft.exe' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='FontCraft'/>
            </Directory>
        </Directory>
        <Feature Id='ProductFeature' Title='FontCraft' Level='1'>
            <ComponentRef Id='MainExecutable'/>
        </Feature>
        <InstallExecuteSequence>
            <LaunchConditions After='AppSearch' />
            <ValidateProductID Before='CostInitialize' />
            <CostInitialize Before='FileCost' />
            <FileCost Before='CostFinalize' />
            <CostFinalize Before='InstallValidate' />
            <InstallValidate Before='InstallInitialize' />
            <InstallInitialize Before='ProcessComponents' />
            <ProcessComponents Before='UnpublishFeatures' />
            <UnpublishFeatures Before='RemoveRegistryValues' />
            <RemoveRegistryValues Before='RemoveShortcuts' />
            <RemoveShortcuts Before='RemoveFiles' />
            <RemoveFiles Before='InstallFiles' />
            <InstallFiles Before='RegisterUser' />
            <RegisterUser Before='RegisterProduct' />
            <RegisterProduct Before='PublishFeatures' />
            <PublishFeatures Before='PublishProduct' />
            <PublishProduct Before='InstallFinalize' />
            <InstallFinalize After='PublishProduct' />
        </InstallExecuteSequence>
    </Product>
</Wix>
